#!/usr/bin/env bash
set -euo pipefail

current=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null || true)
dirs=(
  "$HOME/.local/state/omarchy/current/theme/backgrounds"
  "$HOME/.config/omarchy/backgrounds/$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || true)"
  "$HOME/Pictures/Omarchy-backgrounds"
)
shopt -s nullglob
for dir in "$HOME/.config/omarchy/themes"/*/backgrounds /usr/share/omarchy/themes/*/backgrounds; do
  dirs+=("$dir")
done
shopt -u nullglob

omarchy-menu-images --selected "$current" "${dirs[@]}"
